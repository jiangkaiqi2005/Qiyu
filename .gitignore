node_modules/
.env.local
qiyu.config.local.json
*.log

# Local agent-tool directories and files: skill packs, Claude, CodeBuddy and
# ZCode local state, scratch notes, and the skills lockfile stay machine-local.
# .codebuddy/skills holds symlinks into .agents/skills only, so it carries no
# source of its own. The .scratch pattern also matches scratch directories
# nested inside each app.
.agents/
.claude/
.cline/
.codebuddy/
.zcode/
.scratch/
skills-lock.json

# Workspace-scoped agent memory (daily logs and curated notes). Local runtime
# state, never source.
.workbuddy/

# Mimosa security-scan runtime artifacts (hooks, ledgers, reports) at any depth.
.mimosa/

# Qoder working directory: per-checkout session and worktree data generated
# locally by the tool. Local runtime output, never source.
.qoder/

# Codebase-memory knowledge graph artifacts, refreshed by the local indexer.
.codebase-memory/
