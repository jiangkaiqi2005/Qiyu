# Local ticket acceptance workspaces. Already tracked evidence stays versioned.
.scratch/ticket*/

# Mimosa security-scan runtime artifacts (hooks, ledgers, reports) at any depth.
.mimosa/

# Agent working trees / runtime artifacts. Each worktree holds a full copy of
