<?xml version="1.0" encoding="utf-8"?>
<!-- 旧版（Android 7 至 11）云备份与 adb 备份的排除规则，与 Android
     12 及以上的 data_extraction_rules.xml 同一意图：应用私有内部存储
     全域一概排除。运行数据在 support 目录（file 域：会话与记忆、
     provider.json、音量偏好），凭据密文在 SharedPreferences（sharedpref
     域），root 域作父目录兜底。手动导出落在用户选定的外部位置，不受
     本规则影响。 -->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
